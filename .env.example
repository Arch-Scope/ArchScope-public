# Copy to .env.local and replace placeholders with local values.

# Prisma PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Generate a unique secret with: openssl rand -base64 32
JWT_SECRET=

# Required for the AI architecture assistant
OPENAI_API_KEY=

# Required for password reset email delivery
RESEND_API_KEY=
APP_URL="http://localhost:3000"
